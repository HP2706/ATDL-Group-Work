# Copy to scripts/gcp/gcp.env (gitignored) and fill in. Read by build.sh, submit.sh, vm_run.sh.
PROJECT_ID=
REGION=europe-west4
REPOSITORY=vidsam3d                 # Artifact Registry Docker repository (created if missing)
IMAGE_NAME=vidsam3d
IMAGE_TAG=latest
GCS_BUCKET=                         # mounted at /gcs/$GCS_BUCKET (dataset/, outputs/, cache/, checkpoints/)
SERVICE_ACCOUNT=                    # needs Storage access to the bucket
# Machine for Vertex AI jobs; fill in one of, e.g.:
#   a2-highgpu-1g  + NVIDIA_TESLA_A100   (A100 40 GB)
#   a2-ultragpu-1g + NVIDIA_A100_80GB    (A100 80 GB)
#   a3-highgpu-1g  + NVIDIA_H100_80GB    (H100 80 GB)
MACHINE_TYPE=
ACCELERATOR_TYPE=
ACCELERATOR_COUNT=1
HF_SECRET=                          # optional: Secret Manager secret with the HF token (else $HF_TOKEN)
BUILD_MACHINE=e2-highcpu-32         # Cloud Build machine for the image (CUDA extensions compile)
